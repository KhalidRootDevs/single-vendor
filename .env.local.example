# =============================================================================
# SINGLE-VENDOR ECOMMERCE — ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
#
# Required keys are marked  ← REQUIRED
# Optional keys show their default or leave blank to disable the feature.
# =============================================================================


# ── App ───────────────────────────────────────────────────────────────────────
# Public base URL used for building absolute links in emails and OAuth callbacks.
NEXT_PUBLIC_BASE_URL=http://localhost:3005          # ← REQUIRED
APP_URL=http://localhost:3005                        # ← REQUIRED  (server-side counterpart)


# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB connection string. Use Atlas for production.
MONGODB_URI=mongodb://localhost:27017/single-vendor  # ← REQUIRED


# ── Authentication ────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-64-char-random-hex-string  # ← REQUIRED
JWT_EXPIRES_IN=7d                                    # optional — default: 7d

# Bootstrap: set to "true" in production ONLY when you need to create the
# first admin user via POST /api/setup. Remove after first login.
ALLOW_SETUP=                                         # optional — default: disabled in production


# ── Stripe (Payments) ─────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_                      # ← REQUIRED for checkout
STRIPE_SECRET_KEY=sk_test_                           # ← REQUIRED for checkout
# Get the webhook secret from https://dashboard.stripe.com/webhooks
# Run locally: stripe listen --forward-to localhost:3005/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_                         # ← REQUIRED for webhooks


# ── PayPal (Payments — optional) ──────────────────────────────────────────────
# Get these from https://developer.paypal.com/dashboard/
# Leave blank to disable PayPal as a payment method.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=


# ── Cloudinary (Image Uploads) ────────────────────────────────────────────────
# Get these from https://console.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=                               # ← REQUIRED for image uploads
CLOUDINARY_API_KEY=                                  # ← REQUIRED for image uploads
CLOUDINARY_API_SECRET=                               # ← REQUIRED for image uploads


# ── Email / SMTP ─────────────────────────────────────────────────────────────
# Used for order confirmations, password resets, abandoned cart emails, etc.
# For development use Mailtrap (https://mailtrap.io) or Mailhog.
# For production use SendGrid, Resend, AWS SES, Postmark, etc.
SMTP_HOST=smtp.mailtrap.io                           # ← REQUIRED for transactional emails
SMTP_PORT=587                                        # optional — default: 587
SMTP_USER=                                           # ← REQUIRED for transactional emails
SMTP_PASS=                                           # ← REQUIRED for transactional emails
SMTP_FROM=noreply@yourstore.com                      # optional — default: noreply@yourstore.com


# ── Google OAuth + One-Tap ────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
# Authorised redirect URI: APP_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=                                    # ← REQUIRED for Google sign-in
GOOGLE_CLIENT_SECRET=                                # ← REQUIRED for Google sign-in
# Must match GOOGLE_CLIENT_ID — exposed to the browser for the One-Tap widget.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=                        # ← REQUIRED for Google One-Tap


# ── Upstash Redis (Rate Limiting) ─────────────────────────────────────────────
# Get these from https://console.upstash.com → Create Database → REST API
# Leave blank to disable rate limiting (fine for local development).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ── Testing (auto-set by test runner — do not set manually) ──────────────────
# MONGO_URI_FOR_TESTS is injected by tests/setup.ts via MongoMemoryServer.
# Do not set this value here.
# MONGO_URI_FOR_TESTS=
