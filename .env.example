NODE_ENV=development
APP_URL="http://localhost:3005"
NEXT_PUBLIC_BASE_URL="http://localhost:3005"

# ─── Database ────────────────────────────────────────────────────
# Get from: https://cloud.mongodb.com → Clusters → Connect → Drivers
MONGODB_URI=""

# ─── Storage (Cloudinary) ────────────────────────────────────────
# Get from: https://console.cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Stripe Payments ─────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_PUBLIC=""
STRIPE_SECRET=""
# Get from: Stripe Dashboard → Developers → Webhooks → Add endpoint
# Endpoint URL: https://yourdomain.com/api/webhooks/stripe
# Events to listen: payment_intent.succeeded, payment_intent.payment_failed, charge.refunded
STRIPE_WEBHOOK_SECRET=""

# ─── Authentication ───────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET="CHANGE_ME_generate_with_openssl_rand_hex_32"
JWT_EXPIRES_IN=7d
AUTH_TOKEN_KEY="authtoken"
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET="CHANGE_ME_generate_with_openssl_rand_hex_32"
# Generate with: openssl rand -hex 16
OTP_TOKEN_KEY="CHANGE_ME_generate_with_openssl_rand_hex_16"
OTP_VALIDITY=300
# Remove DEMO_OTP in production — only used for testing
DEMO_OTP=123456
# Generate with: openssl rand -hex 32
ENCRYPTION_SECRET="CHANGE_ME_generate_with_openssl_rand_hex_32"

# ─── Email (SMTP) ─────────────────────────────────────────────────
# Gmail example: smtp.gmail.com / port 587 / use App Password
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your@gmail.com"
SMTP_PASS="your_app_password"
SMTP_FROM="Store Name <no-reply@yourdomain.com>"

# ─── PayPal ───────────────────────────────────────────────────────
# Sandbox: https://api-m.sandbox.paypal.com
# Production: https://api-m.paypal.com
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"

# ─── Google OAuth (optional) ──────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs → Credentials
# Authorized redirect URI: http://localhost:3005/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Promo Codes (optional) ───────────────────────────────────────
# JSON array — managed via env until admin UI promo module is added
# Example: [{"code":"SAVE10","discountPercent":10,"minSubtotal":50}]
PROMO_CODES='[]'
